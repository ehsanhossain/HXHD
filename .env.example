# Copy to .env.local (gitignored) and fill in, or set these as environment
# variables in your host's dashboard. Restart the server after any change —
# Next.js reads env vars once at boot.
#
# Without SMTP_USER and SMTP_PASS, /api/contact returns 503 `not_configured`
# and every form degrades to opening a pre-addressed mailto: draft instead.
# The site still works; submissions just depend on the visitor pressing Send.
#
# Recipients are NOT configured here — they live in FORM_RECIPIENTS in
# src/data/company.ts.

# Gmail account used to authenticate with SMTP. Appears as the sender.
# Does not have to be one of the recipients.
SMTP_USER=

# Google App Password (16 characters), NOT the account login password.
# Requires 2-Step Verification on the account above:
#   myaccount.google.com/apppasswords
SMTP_PASS=

# Display name shown beside the sender address in the inbox.
SMTP_FROM_NAME="HXHD Website"

# 465 = implicit TLS. Use 587 if the host blocks 465 — the route switches to
# STARTTLS automatically for any port that is not 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
